<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:CharacterSheet.Controls">

  <!-- ── AdvCircle: self-contained circle; code-behind sets fill/stroke ── -->
  <Style TargetType="{x:Type ctrl:AdvCircle}">
    <Setter Property="Cursor"  Value="Hand"/>
    <Setter Property="ToolTip" Value="Attrition"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:AdvCircle}">
          <Ellipse x:Name="PART_Ellipse"
                   Width="{TemplateBinding Width}"
                   Height="{TemplateBinding Height}"
                   Stroke="#5A2E0E"
                   StrokeThickness="1.5"
                   Fill="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── DieBubble: numeric rating bubble (0 inactive · 3–18 active) ──── -->
  <Style TargetType="{x:Type ctrl:DieBubble}">
    <Setter Property="Cursor"      Value="Hand"/>
    <Setter Property="ContextMenu" Value="{x:Null}"/>
    <Setter Property="ToolTip"     Value="Left-click +1 · Right-click −1 (3 – 18, requires a skill)"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:DieBubble}">
          <Grid>
            <Ellipse x:Name="PART_Ellipse"
                     Fill="#F2E4C0"
                     Stroke="#5A2E0E"
                     StrokeThickness="1.5"/>
            <!-- Rain sits at left-bottom; shown by code when WeatherPenaltyValue < 0 -->
            <TextBlock x:Name="PART_RainLabel"
                       Text="☂"
                       FontFamily="Segoe UI Emoji"
                       FontSize="9"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="2,0,0,1"
                       Opacity="0.85"
                       Visibility="Collapsed"/>
            <!-- Leaf sits at right-bottom; shown by code when HasBonus is true -->
            <TextBlock x:Name="PART_LeafLabel"
                       Text="🍃"
                       FontFamily="Segoe UI Emoji"
                       FontSize="9"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,2,1"
                       Opacity="0.85"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="PART_Label"
                       Text="d6"
                       FontFamily="Palatino Linotype"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#5A5A2A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
