<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:CharacterSheet.Controls">

  <!-- ── AdvCircle template ────────────────────────────────────────── -->
  <Style TargetType="{x:Type ctrl:AdvCircle}">
    <Setter Property="Width"  Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:AdvCircle}">
          <Ellipse x:Name="PART_Ellipse"
                   Width="20" Height="20"
                   Stroke="#5A2E0E" StrokeThickness="2"
                   Fill="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── DieBubble template ─────────────────────────────────────────── -->
  <Style TargetType="{x:Type ctrl:DieBubble}">
    <Setter Property="Width"  Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Click to advance die"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:DieBubble}">
          <Grid Width="44" Height="44">
            <Ellipse x:Name="PART_Ellipse"
                     Stroke="#5A2E0E" StrokeThickness="2.5"
                     Fill="#F2E4C0"/>
            <TextBlock x:Name="PART_Label"
                       Text="d6"
                       FontFamily="Palatino Linotype"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#5A2E0E"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
