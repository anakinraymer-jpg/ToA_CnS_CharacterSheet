<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:CharacterSheet.Controls">

  <!-- ── AdvCircle: self-contained circle; code-behind sets fill/stroke ── -->
  <Style TargetType="{x:Type ctrl:AdvCircle}">
    <Setter Property="Cursor"  Value="Hand"/>
    <Setter Property="ToolTip" Value="Click to mark used"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:AdvCircle}">
          <Ellipse x:Name="PART_Ellipse"
                   Width="{TemplateBinding Width}"
                   Height="{TemplateBinding Height}"
                   Stroke="#5A2E0E"
                   StrokeThickness="1.5"
                   Fill="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── DieBubble: coloured ring + die label; code-behind drives colours ─ -->
  <Style TargetType="{x:Type ctrl:DieBubble}">
    <Setter Property="Cursor"  Value="Hand"/>
    <Setter Property="ToolTip" Value="Click to advance die"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:DieBubble}">
          <Grid>
            <Ellipse x:Name="PART_Ellipse"
                     Fill="#F2E4C0"
                     Stroke="#5A2E0E"
                     StrokeThickness="1.5"/>
            <TextBlock x:Name="PART_Label"
                       Text="d6"
                       FontFamily="Palatino Linotype"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#5A5A2A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
