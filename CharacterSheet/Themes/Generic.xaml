<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:CharacterSheet.Controls">

  <!-- ── AdvCircle template ────────────────────────────────────────── -->
  <Style TargetType="{x:Type ctrl:AdvCircle}">
    <Setter Property="Width"  Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:AdvCircle}">
          <Ellipse x:Name="PART_Ellipse"
                   Width="16" Height="16"
                   Stroke="#5A2E0E" StrokeThickness="1.5"
                   Fill="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── DieBubble template ─────────────────────────────────────────── -->
  <Style TargetType="{x:Type ctrl:DieBubble}">
    <Setter Property="Width"  Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Click to advance die"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:DieBubble}">
          <Grid Width="36" Height="36">
            <Ellipse x:Name="PART_Ellipse"
                     Stroke="#5A2E0E" StrokeThickness="2"
                     Fill="#F2E4C0"/>
            <TextBlock x:Name="PART_Label"
                       Text="d6"
                       FontFamily="Palatino Linotype"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#5A2E0E"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
