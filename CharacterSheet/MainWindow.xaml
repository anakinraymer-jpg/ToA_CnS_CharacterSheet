<Window x:Class="CharacterSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:CharacterSheet.Controls"
        Title="Crown &amp; Skull — Character Sheet"
        Width="860" Height="1020"
        MinWidth="500" MinHeight="600"
        Background="#110A02"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <ResourceDictionary Source="/Resources/Themes.xaml"/>
  </Window.Resources>

  <DockPanel>

    <!-- ══ CONTROLS BAR ══ -->
    <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Center"
               Margin="0,12,0,12" Orientation="Horizontal">
      <Button x:Name="BtnNew"    Content="☠ New Character"
              Style="{StaticResource CtrlButton}" Margin="4,0"/>
      <Button x:Name="BtnExport" Content="↓ Export"
              Style="{StaticResource CtrlButton}" Margin="4,0"/>
      <Button x:Name="BtnImport" Content="↑ Import"
              Style="{StaticResource CtrlButton}" Margin="4,0"/>
      <!-- divider -->
      <Separator Width="1" Height="24" Background="#6B3A12" Margin="12,0"/>
      <!-- zoom controls -->
      <Button x:Name="BtnZoomOut" Content="−" Padding="12,8"
              Style="{StaticResource CtrlButton}" Margin="4,0"
              ToolTip="Zoom out  (Ctrl -)"/>
      <TextBlock x:Name="TbZoom" Text="100%"
                 Foreground="#D4A96A" FontFamily="Palatino Linotype" FontSize="14"
                 Width="52" TextAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
      <Button x:Name="BtnZoomIn" Content="+" Padding="12,8"
              Style="{StaticResource CtrlButton}" Margin="4,0"
              ToolTip="Zoom in  (Ctrl +)"/>
      <Button x:Name="BtnZoomFit" Content="⊡ Fit" Padding="10,8"
              Style="{StaticResource CtrlButton}" Margin="4,0"
              ToolTip="Fit sheet to window  (Ctrl 0)"/>
    </WrapPanel>

    <!-- ══ SHEET: ScaleTransform on Canvas; ScrollViewer handles overflow ══ -->
    <ScrollViewer x:Name="SheetScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnScrollWheel">
      <Grid>
        <Canvas x:Name="SheetCanvas"
                Width="595.2" Height="841.9"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="10,0,10,20">
          <Canvas.LayoutTransform>
            <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1"/>
          </Canvas.LayoutTransform>

          <!-- PDF background image -->
          <Image Canvas.Left="0" Canvas.Top="0"
                 Width="595.2" Height="841.9"
                 Source="/Assets/sheet_bg.png"
                 RenderOptions.BitmapScalingMode="HighQuality"/>

          <!-- ── Portrait ──────────────────────────────────────────── -->
          <Image x:Name="PortraitImg"
                 Canvas.Left="461" Canvas.Top="6"
                 Width="127" Height="230"
                 Stretch="UniformToFill" Visibility="Collapsed"/>
          <!-- Clickable portrait overlay -->
          <Rectangle x:Name="PortraitBox"
                     Canvas.Left="461" Canvas.Top="6"
                     Width="127" Height="230"
                     Fill="Transparent" Cursor="Hand"
                     ToolTip="Click to upload portrait"/>

          <!-- ── Header ──────────────────────────────────────────────── -->
          <TextBox Canvas.Left="118.4" Canvas.Top="38.8" Width="339.3" Height="23.7" Style="{StaticResource OverlayTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="118.4" Canvas.Top="64.8" Width="340.0" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Lineage, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="117.8" Canvas.Top="93.5" Width="340.7" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Hometown, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="90.4"  Canvas.Top="121.5" Width="176.0" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Flaw1, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="281.1" Canvas.Top="121.5" Width="176.7" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Flaw2, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="33.1"  Canvas.Top="150.2" Width="232.7" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Extra1, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="281.1" Canvas.Top="150.2" Width="274.7" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Extra2, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="90.4"  Canvas.Top="178.2" Width="464.7" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Summa1, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="33.8"  Canvas.Top="205.5" Width="521.3" Height="25.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Summa2, UpdateSourceTrigger=PropertyChanged}"/>

          <!-- ── Row 0 ─────────────────────────────────────────────── -->
          <TextBox Canvas.Left="35.8" Canvas.Top="266.3" Width="200.7" Height="20.3" Style="{StaticResource OverlayTextBox}" Text="{Binding Rows[0].EquipName, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="35.8" Canvas.Top="286.7" Width="200.7" Height="13.0" Style="{StaticResource OverlayTextBox}" Text="{Binding Rows[0].EquipSub,  UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="353.8" Canvas.Top="266.4" Width="168.0" Height="20.3" Style="{StaticResource OverlayTextBox}" Text="{Binding Rows[0].SkillName, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Canvas.Left="353.8" Canvas.Top="286.6" Width="168.0" Height="11.7" Style="{StaticResource OverlayTextBox}" Text="{Binding Rows[0].SkillSub,  UpdateSourceTrigger=PropertyChanged}"/>
          <ctrl:AdvCircle Canvas.Left="242.4" Canvas.Top="276.4" Width="16.0" Height="17.6" IsChecked="{Binding Rows[0].EquipUsed, Mode=TwoWay}"/>
          <ctrl:AdvCircle Canvas.Left="332.4" Canvas.Top="275.8" Width="16.8" Height="17.6" IsChecked="{Binding Rows[0].SkillAdv,  Mode=TwoWay}"/>
          <ctrl:DieBubble Canvas.Left="531.8" Canvas.Top="263.0" Width="23.3" Height="23.7" Die="{Binding Rows[0].Die, Mode=TwoWay}"/>

