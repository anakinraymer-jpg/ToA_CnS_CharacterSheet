<Window x:Class="CharacterSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:CharacterSheet.Controls"
        Title="Crown &amp; Skull — Character Sheet"
        Width="860" Height="960"
        MinWidth="480" MinHeight="500"
        Background="#110A02"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <ResourceDictionary Source="/Resources/Themes.xaml"/>
  </Window.Resources>

  <DockPanel>

    <!-- ══ CONTROL BAR ══════════════════════════════════════════════ -->
    <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Center"
               Margin="0,12,0,12" Orientation="Horizontal">
      <Button x:Name="BtnNew"    Content="☠ New Character"
              Style="{StaticResource CtrlButton}" Margin="4,0"/>
      <Button x:Name="BtnExport" Content="↓ Export"
              Style="{StaticResource CtrlButton}" Margin="4,0"/>
      <Button x:Name="BtnImport" Content="↑ Import"
              Style="{StaticResource CtrlButton}" Margin="4,0"/>
      <Separator Width="1" Height="24" Background="#6B3A12" Margin="12,0"/>
      <Button x:Name="BtnZoomOut" Content="−" Padding="12,8"
              Style="{StaticResource CtrlButton}" Margin="4,0" ToolTip="Zoom out  (Ctrl -)"/>
      <TextBlock x:Name="TbZoom" Text="100%"
                 Foreground="#D4A96A" FontFamily="Palatino Linotype" FontSize="14"
                 Width="52" TextAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
      <Button x:Name="BtnZoomIn" Content="+" Padding="12,8"
              Style="{StaticResource CtrlButton}" Margin="4,0" ToolTip="Zoom in  (Ctrl +)"/>
      <Button x:Name="BtnZoomFit" Content="⊡ Fit" Padding="10,8"
              Style="{StaticResource CtrlButton}" Margin="4,0" ToolTip="Fit to window  (Ctrl 0)"/>
    </WrapPanel>

    <!-- ══ SHEET ════════════════════════════════════════════════════ -->
    <ScrollViewer x:Name="SheetScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnScrollWheel">
      <Grid>

        <!-- Parchment sheet — fixed 680-unit width, centred, zoomable -->
        <Border x:Name="SheetContent"
                Width="680"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="20,20,20,40"
                Background="{StaticResource SheetGradient}"
                BorderBrush="{StaticResource BrownLtBrush}" BorderThickness="1"
                CornerRadius="3">
          <Border.LayoutTransform>
            <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1"/>
          </Border.LayoutTransform>

          <StackPanel Margin="32,26,32,28">

            <!-- ─── TITLE ─────────────────────────────────────────── -->
            <TextBlock Text="CROWN &amp; SKULL"
                       FontFamily="Palatino Linotype" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource RedBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Hero Sheet"
                       FontFamily="Palatino Linotype" FontSize="13"
                       Foreground="{StaticResource BrownBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,20"/>

            <!-- ─── IDENTITY + PORTRAIT ───────────────────────────── -->
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="148"/>
              </Grid.ColumnDefinitions>

              <!-- Character / Lineage / Hometown -->
              <StackPanel Grid.Column="0">
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Left" Text="CHARACTER" Width="90"
                             Style="{StaticResource FieldLabel}"/>
                  <TextBox Style="{StaticResource HdrTextBox}"
                           Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Left" Text="LINEAGE" Width="90"
                             Style="{StaticResource FieldLabel}"/>
                  <TextBox Style="{StaticResource HdrTextBox}"
                           Text="{Binding Lineage, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Left" Text="HOMETOWN" Width="90"
                             Style="{StaticResource FieldLabel}"/>
                  <TextBox Style="{StaticResource HdrTextBox}"
                           Text="{Binding Hometown, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
              </StackPanel>

              <!-- Portrait box -->
              <Border x:Name="PortraitBox" Grid.Column="2"
                      BorderBrush="{StaticResource BrownLtBrush}" BorderThickness="1"
                      CornerRadius="2" Cursor="Hand" ToolTip="Click to upload portrait"
                      Background="#0A000000">
                <Grid>
                  <TextBlock Text="Portrait"
                             FontFamily="Palatino Linotype" FontSize="11" Opacity="0.4"
                             Foreground="{StaticResource BrownBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="PortraitImg"
                         Stretch="UniformToFill"
                         Visibility="Collapsed"/>
                </Grid>
              </Border>
            </Grid>

            <!-- ─── FLAWS ──────────────────────────────────────────── -->
            <Rectangle Height="1" Fill="{StaticResource BrownLtBrush}" Opacity="0.35" Margin="0,14,0,10"/>
            <TextBlock Text="FLAWS" Style="{StaticResource SectionHeader}"/>
            <DockPanel Margin="0,3">
              <TextBlock DockPanel.Dock="Left" Text="①" Width="20" Style="{StaticResource FieldLabel}"/>
              <TextBox Style="{StaticResource HdrTextBox}"
                       Text="{Binding Flaw1, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <DockPanel Margin="0,3">
              <TextBlock DockPanel.Dock="Left" Text="②" Width="20" Style="{StaticResource FieldLabel}"/>
              <TextBox Style="{StaticResource HdrTextBox}"
                       Text="{Binding Flaw2, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <DockPanel Margin="0,3">
              <TextBlock DockPanel.Dock="Left" Text="③" Width="20" Style="{StaticResource FieldLabel}"/>
              <TextBox Style="{StaticResource HdrTextBox}"
                       Text="{Binding Flaw3, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <DockPanel Margin="0,3">
              <TextBlock DockPanel.Dock="Left" Text="④" Width="20" Style="{StaticResource FieldLabel}"/>
              <TextBox Style="{StaticResource HdrTextBox}"
                       Text="{Binding Flaw4, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <!-- ─── CORE ABILITY ──────────────────────────────────── -->
            <Rectangle Height="1" Fill="{StaticResource BrownLtBrush}" Opacity="0.35" Margin="0,14,0,10"/>
            <TextBlock Text="CORE ABILITY" Style="{StaticResource SectionHeader}"/>
            <TextBox Style="{StaticResource HdrTextBox}"
                     Text="{Binding CoreAbility, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- ─── SUMMARY ────────────────────────────────────────── -->
            <Rectangle Height="1" Fill="{StaticResource BrownLtBrush}" Opacity="0.35" Margin="0,14,0,10"/>
            <TextBlock Text="SUMMARY" Style="{StaticResource SectionHeader}"/>
            <TextBox Style="{StaticResource SummaryTextBox}"
                     Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- ─── EQUIPMENT &amp; SKILLS ────────────────────────── -->
            <Rectangle Height="1" Fill="{StaticResource BrownLtBrush}" Opacity="0.35" Margin="0,20,0,10"/>
            <TextBlock Text="EQUIPMENT &amp; SKILLS" Style="{StaticResource SectionHeader}"/>

            <!-- Column headers with + buttons -->
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- equipment side -->
                <ColumnDefinition Width="1"/>   <!-- divider -->
                <ColumnDefinition Width="20"/>  <!-- adv-circle gutter (skill side) -->
                <ColumnDefinition Width="*"/>   <!-- skill name -->
                <ColumnDefinition Width="44"/>  <!-- die -->
              </Grid.ColumnDefinitions>

              <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <Button x:Name="BtnAddEquip" DockPanel.Dock="Left"
                        Content="+" Style="{StaticResource AddButton}"
                        ToolTip="Add equipment" Margin="0,0,5,0"/>
                <TextBlock Text="EQUIPMENT" Style="{StaticResource FieldLabel}" Margin="0"/>
              </DockPanel>

              <DockPanel Grid.Column="3" Margin="6,0,0,0">
                <TextBlock Text="SKILL" Style="{StaticResource FieldLabel}" Margin="0"/>
                <Button x:Name="BtnAddSkill" DockPanel.Dock="Left"
                        Content="+" Style="{StaticResource AddButton}"
                        ToolTip="Add skill" Margin="5,0,0,0"/>
              </DockPanel>

              <TextBlock Grid.Column="4" Text="DIE"
                         Style="{StaticResource FieldLabel}" Margin="0"
                         TextAlignment="Center"/>
            </Grid>

            <!-- Two independent lists: equipment (left) | adv · skill · die (right) -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- equipment -->
                <ColumnDefinition Width="1"/>   <!-- spine -->
                <ColumnDefinition Width="20"/>  <!-- adv circle -->
                <ColumnDefinition Width="*"/>   <!-- skill name -->
                <ColumnDefinition Width="44"/>  <!-- die bubble -->
              </Grid.ColumnDefinitions>

              <!-- Equipment list -->
              <ItemsControl Grid.Column="0" ItemsSource="{Binding Equipment}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#28000000" BorderThickness="0,0,0,1"
                            Padding="0,5,6,5" MinHeight="34">
                      <DockPanel VerticalAlignment="Center">
                        <ctrl:AdvCircle DockPanel.Dock="Right"
                                        Width="20" Height="20" VerticalAlignment="Center"
                                        IsChecked="{Binding Used, Mode=TwoWay}"
                                        ToolTip="Mark used"/>
                        <TextBox Style="{StaticResource RowNameTextBox}"
                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Tooltip}"
                                 ToolTipService.ShowDuration="30000"
                                 VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Vertical spine -->
              <Rectangle Grid.Column="1"
                         Fill="{StaticResource ParchmentDkBrush}" Opacity="0.5"/>

              <!-- Adv-circle column (aligned with skill rows) -->
              <ItemsControl Grid.Column="2" ItemsSource="{Binding Skills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#28000000" BorderThickness="0,0,0,1"
                            Padding="4,5,2,5" MinHeight="34">
                      <ctrl:AdvCircle Width="20" Height="20"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Adv, Mode=TwoWay}"
                                      ToolTip="Mark advancement"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Skill-name column (SkillPickerBox with custom description override) -->
              <ItemsControl Grid.Column="3" ItemsSource="{Binding Skills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#28000000" BorderThickness="0,0,0,1"
                            Padding="2,5,2,5" MinHeight="34">
                      <ctrl:SkillPickerBox
                              VerticalAlignment="Center"
                              SelectedSkill="{Binding Name, Mode=TwoWay}"
                              CustomDescription="{Binding Description}"
                              ToolTipService.ShowDuration="30000"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Die-bubble column -->
              <ItemsControl Grid.Column="4" ItemsSource="{Binding Skills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#28000000" BorderThickness="0,0,0,1"
                            Padding="2,5,0,5" MinHeight="34">
                      <ctrl:DieBubble Width="36" Height="36"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Value="{Binding Rating, Mode=TwoWay}"
                                      HasSkill="{Binding HasSkill}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </Grid>

            <!-- ─── SPELLS ─────────────────────────────────────────── -->
            <Rectangle Height="1" Fill="{StaticResource BrownLtBrush}" Opacity="0.35" Margin="0,20,0,10"/>
            <TextBlock Text="SPELLS" Style="{StaticResource SectionHeader}"/>
            <DockPanel Margin="0,4">
              <TextBlock DockPanel.Dock="Left" Text="①" Width="20" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TbSpell0" Style="{StaticResource HdrTextBox}"/>
            </DockPanel>
            <DockPanel Margin="0,4">
              <TextBlock DockPanel.Dock="Left" Text="②" Width="20" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TbSpell1" Style="{StaticResource HdrTextBox}"/>
            </DockPanel>
            <DockPanel Margin="0,4">
              <TextBlock DockPanel.Dock="Left" Text="③" Width="20" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TbSpell2" Style="{StaticResource HdrTextBox}"/>
            </DockPanel>

          </StackPanel>
        </Border>

      </Grid>
    </ScrollViewer>

  </DockPanel>
</Window>
