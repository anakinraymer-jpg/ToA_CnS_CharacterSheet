<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:CharacterSheet.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ── Colour palette ─────────────────────────────────────────────── -->
  <Color x:Key="Parchment">#F2E4C0</Color>
  <Color x:Key="ParchmentDk">#E0CC98</Color>
  <Color x:Key="Ink">#1A0D02</Color>
  <Color x:Key="Brown">#5A2E0E</Color>
  <Color x:Key="BrownLt">#8B5A2B</Color>
  <Color x:Key="Red">#7A1A0A</Color>
  <Color x:Key="Gold">#B8860B</Color>
  <Color x:Key="PageBg">#110A02</Color>

  <SolidColorBrush x:Key="ParchmentBrush"   Color="{StaticResource Parchment}"/>
  <SolidColorBrush x:Key="ParchmentDkBrush" Color="{StaticResource ParchmentDk}"/>
  <SolidColorBrush x:Key="InkBrush"         Color="{StaticResource Ink}"/>
  <SolidColorBrush x:Key="BrownBrush"       Color="{StaticResource Brown}"/>
  <SolidColorBrush x:Key="BrownLtBrush"     Color="{StaticResource BrownLt}"/>
  <SolidColorBrush x:Key="RedBrush"         Color="{StaticResource Red}"/>
  <SolidColorBrush x:Key="GoldBrush"        Color="{StaticResource Gold}"/>
  <SolidColorBrush x:Key="PageBgBrush"      Color="{StaticResource PageBg}"/>

  <!-- Die colours -->
  <SolidColorBrush x:Key="DieBrush_d4"  Color="#7A6A3A"/>
  <SolidColorBrush x:Key="DieBrush_d6"  Color="#5A5A2A"/>
  <SolidColorBrush x:Key="DieBrush_d8"  Color="#2A5A3A"/>
  <SolidColorBrush x:Key="DieBrush_d10" Color="#2A3A6A"/>
  <SolidColorBrush x:Key="DieBrush_d12" Color="#6A1A2A"/>

  <!-- ── Fonts ──────────────────────────────────────────────────────── -->
  <FontFamily x:Key="TitleFont">Palatino Linotype</FontFamily>
  <FontFamily x:Key="LabelFont">Palatino Linotype</FontFamily>
  <FontFamily x:Key="InputFont">Segoe UI</FontFamily>

  <!-- ── Sheet background gradient ─────────────────────────────────── -->
  <LinearGradientBrush x:Key="SheetGradient" StartPoint="0.2,0.1" EndPoint="0.8,0.9">
    <GradientStop Color="#F2E4C0" Offset="0"/>
    <GradientStop Color="#ECCAA0" Offset="0.5"/>
    <GradientStop Color="#E0CC98" Offset="1"/>
  </LinearGradientBrush>

  <!-- ── Shared placeholder template helper ────────────────────────── -->
  <!-- Each text box style embeds a watermark TextBlock bound to ctrl:TextBoxHelper.Placeholder -->

  <!-- ── Header input — underline, with placeholder ────────────────── -->
  <Style x:Key="HdrTextBox" TargetType="TextBox">
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="Foreground"   Value="{StaticResource InkBrush}"/>
    <Setter Property="FontFamily"   Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"     Value="16"/>
    <Setter Property="Padding"      Value="2,2"/>
    <Setter Property="CaretBrush"   Value="{StaticResource BrownBrush}"/>
    <Setter Property="SelectionBrush" Value="#885A2E0E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border" BorderThickness="0,0,0,1"
                  BorderBrush="{StaticResource BrownLtBrush}"
                  Background="Transparent">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="2,0"/>
              <TextBlock x:Name="ph" IsHitTestVisible="False"
                         Text="{Binding Path=(ctrl:TextBoxHelper.Placeholder),
                                        RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="{StaticResource InputFont}" FontStyle="Italic"
                         FontSize="13" Foreground="#805A2E0E"
                         VerticalAlignment="Center" Margin="4,0"
                         Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="border" Property="Background" Value="#0A5A2E0E"/>
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrownBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Row name input — faint underline ──────────────────────────── -->
  <Style x:Key="RowNameTextBox" TargetType="TextBox">
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="Foreground"   Value="{StaticResource InkBrush}"/>
    <Setter Property="FontFamily"   Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"     Value="16"/>
    <Setter Property="Padding"      Value="2,2"/>
    <Setter Property="CaretBrush"   Value="{StaticResource BrownBrush}"/>
    <Setter Property="SelectionBrush" Value="#885A2E0E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border" BorderThickness="0,0,0,1"
                  BorderBrush="#665A2E0E" Background="Transparent">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="2,0"/>
              <TextBlock x:Name="ph" IsHitTestVisible="False"
                         Text="{Binding Path=(ctrl:TextBoxHelper.Placeholder),
                                        RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="{StaticResource InputFont}" FontStyle="Italic"
                         FontSize="12" Foreground="#665A2E0E"
                         VerticalAlignment="Center" Margin="2,0"
                         Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="border" Property="Background" Value="#0A5A2E0E"/>
              <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrownBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Row sub input — smaller, lighter ──────────────────────────── -->
  <Style x:Key="RowSubTextBox" TargetType="TextBox">
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="Foreground"   Value="{StaticResource BrownLtBrush}"/>
    <Setter Property="FontFamily"   Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"     Value="13"/>
    <Setter Property="FontWeight"   Value="Light"/>
    <Setter Property="Padding"      Value="2,1"/>
    <Setter Property="CaretBrush"   Value="{StaticResource BrownBrush}"/>
    <Setter Property="SelectionBrush" Value="#885A2E0E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border" Background="Transparent">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="2,0"/>
              <TextBlock x:Name="ph" IsHitTestVisible="False"
                         Text="{Binding Path=(ctrl:TextBoxHelper.Placeholder),
                                        RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="{StaticResource InputFont}" FontStyle="Italic"
                         FontSize="11" Foreground="#4A8B5A2B"
                         VerticalAlignment="Center" Margin="2,0"
                         Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="border" Property="Background" Value="#0A5A2E0E"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Spell line input ───────────────────────────────────────────── -->
  <Style x:Key="SpellTextBox" TargetType="TextBox">
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="Foreground"   Value="{StaticResource InkBrush}"/>
    <Setter Property="FontFamily"   Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"     Value="16"/>
    <Setter Property="Padding"      Value="4,5"/>
    <Setter Property="CaretBrush"   Value="{StaticResource BrownBrush}"/>
    <Setter Property="SelectionBrush" Value="#885A2E0E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border" BorderThickness="0,0,0,1"
                  BorderBrush="{StaticResource ParchmentDkBrush}"
                  Background="Transparent">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="2,0"/>
              <TextBlock x:Name="ph" IsHitTestVisible="False"
                         Text="{Binding Path=(ctrl:TextBoxHelper.Placeholder),
                                        RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="{StaticResource InputFont}" FontStyle="Italic"
                         FontSize="13" Foreground="#665A2E0E"
                         VerticalAlignment="Center" Margin="4,0"
                         Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="border" Property="Background" Value="#0A5A2E0E"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── PDF overlay TextBox (transparent, sits on top of PDF background) -->
  <Style x:Key="OverlayTextBox" TargetType="TextBox">
    <Setter Property="Background"     Value="Transparent"/>
    <Setter Property="BorderBrush"    Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground"     Value="#CC1A0D02"/>
    <Setter Property="FontFamily"     Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"       Value="11"/>
    <Setter Property="Padding"        Value="1,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush"     Value="{StaticResource BrownBrush}"/>
    <Setter Property="SelectionBrush" Value="#445A2E0E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="1,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1A5A2E0E"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Section header label ─────────────────────────────────────── -->
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontFamily"  Value="{StaticResource TitleFont}"/>
    <Setter Property="FontSize"    Value="10.5"/>
    <Setter Property="FontWeight"  Value="Bold"/>
    <Setter Property="Foreground"  Value="{StaticResource BrownBrush}"/>
    <Setter Property="Margin"      Value="0,0,0,4"/>
  </Style>

  <!-- ── Inline field label (left-docked) ──────────────────────────── -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily"        Value="{StaticResource LabelFont}"/>
    <Setter Property="FontSize"          Value="10"/>
    <Setter Property="Foreground"        Value="{StaticResource BrownLtBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin"            Value="0,0,8,0"/>
  </Style>

  <!-- ── Multi-line summary text area ──────────────────────────────── -->
  <Style x:Key="SummaryTextBox" TargetType="TextBox">
    <Setter Property="Background"                Value="#0A000000"/>
    <Setter Property="Foreground"                Value="{StaticResource InkBrush}"/>
    <Setter Property="FontFamily"                Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"                  Value="14"/>
    <Setter Property="AcceptsReturn"             Value="True"/>
    <Setter Property="TextWrapping"              Value="Wrap"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="MinHeight"                 Value="100"/>
    <Setter Property="Padding"                   Value="8,6"/>
    <Setter Property="CaretBrush"                Value="{StaticResource BrownBrush}"/>
    <Setter Property="SelectionBrush"            Value="#445A2E0E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource BrownLtBrush}"
                  BorderThickness="1"
                  CornerRadius="2"
                  Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrownBrush}"/>
              <Setter TargetName="bd" Property="Background"  Value="#0A5A2E0E"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Small inline [+] button beside column headers ────────────────── -->
  <Style x:Key="AddButton" TargetType="Button">
    <Setter Property="Width"           Value="18"/>
    <Setter Property="Height"          Value="18"/>
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="FontFamily"      Value="{StaticResource TitleFont}"/>
    <Setter Property="FontSize"        Value="14"/>
    <Setter Property="FontWeight"      Value="Bold"/>
    <Setter Property="Foreground"      Value="{StaticResource BrownBrush}"/>
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#225A2E0E"/>
              <Setter Property="Foreground" Value="#AA7A3A0A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#445A2E0E"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Dialog input — light text on dark dialog background ───────────── -->
  <Style x:Key="DialogTextBox" TargetType="TextBox">
    <Setter Property="Background"     Value="Transparent"/>
    <Setter Property="Foreground"     Value="#F2E4C0"/>
    <Setter Property="FontFamily"     Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"       Value="14"/>
    <Setter Property="Padding"        Value="4,3"/>
    <Setter Property="CaretBrush"     Value="#D4A96A"/>
    <Setter Property="SelectionBrush" Value="#445A2E0E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border" BorderThickness="0,0,0,1"
                  BorderBrush="#885A2E0E" Background="Transparent">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="2,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="border" Property="BorderBrush" Value="#CC8B5A2B"/>
              <Setter TargetName="border" Property="Background"  Value="#0AF2E4C0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Small per-row remove [×] button ──────────────────────────────── -->
  <Style x:Key="RemoveButton" TargetType="Button">
    <Setter Property="Width"           Value="16"/>
    <Setter Property="Height"          Value="16"/>
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="FontFamily"      Value="{StaticResource TitleFont}"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="Foreground"      Value="#7A3A2A"/>
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#337A1A0A"/>
              <Setter Property="Foreground" Value="#CC5A0A0A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#557A1A0A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Themed ToolTip ───────────────────────────────────────────────── -->
  <Style TargetType="ToolTip">
    <Setter Property="Background"      Value="{StaticResource ParchmentBrush}"/>
    <Setter Property="Foreground"      Value="{StaticResource InkBrush}"/>
    <Setter Property="BorderBrush"     Value="{StaticResource BrownBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="8,6"/>
    <Setter Property="FontFamily"      Value="{StaticResource InputFont}"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="MaxWidth"        Value="300"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              MaxWidth="284">
              <ContentPresenter.Resources>
                <!-- Strings get a wrapping TextBlock styled to match the sheet theme -->
                <DataTemplate DataType="{x:Type sys:String}">
                  <TextBlock Text="{Binding}"
                             Foreground="{Binding Foreground,
                                         RelativeSource={RelativeSource AncestorType=ToolTip}}"
                             FontFamily="{Binding FontFamily,
                                         RelativeSource={RelativeSource AncestorType=ToolTip}}"
                             FontSize="{Binding FontSize,
                                       RelativeSource={RelativeSource AncestorType=ToolTip}}"
                             TextWrapping="Wrap"
                             MaxWidth="284"/>
                </DataTemplate>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Control bar button ─────────────────────────────────────────── -->
  <Style x:Key="CtrlButton" TargetType="Button">
    <Setter Property="FontFamily"      Value="{StaticResource TitleFont}"/>
    <Setter Property="FontSize"        Value="14"/>
    <Setter Property="Foreground"      Value="#D4A96A"/>
    <Setter Property="Background"      Value="#2A1205"/>
    <Setter Property="BorderBrush"     Value="#6B3A12"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="18,8"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#3E1A08"/>
              <Setter Property="Foreground" Value="#F0C87A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1A0A03"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Hamburger dropdown ──────────────────────────────────────────── -->

  <!-- Top-level trigger button (the "☰" item inside a transparent Menu) -->
  <Style x:Key="CtrlMenuButton" TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
    <Setter Property="FontSize"   Value="14"/>
    <Setter Property="Foreground" Value="#D4A96A"/>
    <Setter Property="Cursor"     Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="bd"
                    Background="#2A1205" BorderBrush="#6B3A12"
                    BorderThickness="1" CornerRadius="2">
              <ContentPresenter Margin="14,8"
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Bottom" PopupAnimation="Fade">
              <Border Background="#1C0D03" BorderBrush="#6B3A12"
                      BorderThickness="1" Padding="0,3" MinWidth="160">
                <StackPanel IsItemsHost="True"
                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#3E1A08"/>
              <Setter Property="Foreground"                 Value="#F0C87A"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="bd" Property="Background"  Value="#1A0A03"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#A05A20"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Child items inside the hamburger dropdown -->
  <Style x:Key="CtrlDropItem" TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
    <Setter Property="FontSize"   Value="13"/>
    <Setter Property="Foreground" Value="#D4A96A"/>
    <Setter Property="Cursor"     Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" Padding="12,7"
                  TextElement.Foreground="{TemplateBinding Foreground}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="chk" Grid.Column="0" Text="✓" FontSize="11"
                         VerticalAlignment="Center" Visibility="Collapsed"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                         Foreground="#7A4820" FontSize="11" VerticalAlignment="Center"
                         Margin="24,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#3E1A08"/>
              <Setter Property="Foreground"                 Value="#F0C87A"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#604A28"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Divider line between groups of dropdown items -->
  <Style x:Key="CtrlMenuSep" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Fill="#3A1E08" Height="1" Margin="8,3"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
