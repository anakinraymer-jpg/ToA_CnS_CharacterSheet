<Window x:Class="CharacterSheet.Controls.SpecializationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Specialization"
        Width="300"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="#1E1005"
        ShowInTaskbar="False">

  <Window.Resources>
    <ResourceDictionary Source="/Resources/Themes.xaml"/>
  </Window.Resources>

  <Border Padding="20,16,20,18">
    <StackPanel>

      <!-- Flaw name as context header -->
      <TextBlock x:Name="TbTitle"
                 FontFamily="Palatino Linotype" FontSize="13" FontWeight="Bold"
                 Foreground="#D4A96A" Margin="0,0,0,14" TextWrapping="Wrap"/>

      <!-- Input -->
      <TextBlock Text="SPECIALIZATION"
                 FontFamily="Palatino Linotype" FontSize="9"
                 Foreground="#D4A96A" Margin="0,0,0,4"/>
      <TextBox x:Name="TbSpecialization"
               Style="{StaticResource DialogTextBox}"
               ToolTip="Shown in brackets after the flaw name, e.g. Addict [Ale]"/>

      <!-- Buttons -->
      <DockPanel Margin="0,18,0,0">
        <Button x:Name="BtnCancel" DockPanel.Dock="Right"
                Content="Cancel" Style="{StaticResource CtrlButton}"
                Padding="14,6" Margin="8,0,0,0"/>
        <Button x:Name="BtnOk"
                Content="OK" Style="{StaticResource CtrlButton}"
                Padding="20,6" HorizontalAlignment="Right"/>
      </DockPanel>

    </StackPanel>
  </Border>
</Window>
