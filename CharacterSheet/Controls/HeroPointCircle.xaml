<UserControl x:Class="CharacterSheet.Controls.HeroPointCircle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="90" Height="90">

  <Grid>
    <!-- Circle outline (behind everything, non-interactive) -->
    <Ellipse Stroke="#5A2E0E" StrokeThickness="1.5" Fill="Transparent"
             IsHitTestVisible="False"/>

    <!-- Inner layout: top hemisphere | 1px divider | bottom hemisphere -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top hemisphere — Total Points; left-click +1, right-click −1 -->
      <Border x:Name="PART_TopArea" Grid.Row="0"
              Background="Transparent" Cursor="Hand"
              ToolTip="Left-click: +1 total  •  Right-click: −1 total">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="Total Points"
                     HorizontalAlignment="Center"
                     FontFamily="Palatino Linotype" FontSize="7.5"
                     Foreground="#5A2E0E" IsHitTestVisible="False"/>
          <TextBlock x:Name="PART_Max"
                     HorizontalAlignment="Center"
                     FontFamily="Palatino Linotype" FontSize="15" FontWeight="Bold"
                     Foreground="#5A2E0E" IsHitTestVisible="False"/>
        </StackPanel>
      </Border>

      <!-- Divider line -->
      <Rectangle Grid.Row="1" Fill="#5A2E0E" IsHitTestVisible="False"/>

      <!-- Bottom hemisphere — Available Points; left-click spend, right-click restore -->
      <Border x:Name="PART_BottomArea" Grid.Row="2"
              Background="Transparent" Cursor="Hand"
              ToolTip="Left-click: spend a point  •  Right-click: restore">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="Available Points"
                     HorizontalAlignment="Center"
                     FontFamily="Palatino Linotype" FontSize="7.5"
                     Foreground="#5A2E0E" IsHitTestVisible="False"/>
          <TextBlock x:Name="PART_Current"
                     HorizontalAlignment="Center"
                     FontFamily="Palatino Linotype" FontSize="15" FontWeight="Bold"
                     Foreground="#5A2E0E" IsHitTestVisible="False"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
