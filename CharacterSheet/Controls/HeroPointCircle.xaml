<UserControl x:Class="CharacterSheet.Controls.HeroPointCircle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="80" Height="80"
             Cursor="Arrow">

  <Grid>
    <!-- Circle outline -->
    <Ellipse Stroke="#5A2E0E" StrokeThickness="1.5" Fill="Transparent"
             IsHitTestVisible="False"/>

    <!-- Horizontal divider at mid-point -->
    <Rectangle Height="1" Fill="#5A2E0E" VerticalAlignment="Center"
               IsHitTestVisible="False"/>

    <!-- Top hemisphere: MaxPoints centred in upper half -->
    <TextBlock x:Name="PART_Max"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,8,0,0"
               FontFamily="Palatino Linotype" FontSize="15" FontWeight="Bold"
               Foreground="#5A2E0E" IsHitTestVisible="False"/>

    <!-- + button: top-left, near divider -->
    <TextBlock x:Name="PART_Plus" Text="+"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="16,26,0,0"
               FontFamily="Palatino Linotype" FontSize="13" FontWeight="Bold"
               Foreground="#5A2E0E" Cursor="Hand"
               ToolTip="Add a hero point"/>

    <!-- − button: top-right, near divider -->
    <TextBlock x:Name="PART_Minus" Text="−"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,26,16,0"
               FontFamily="Palatino Linotype" FontSize="13" FontWeight="Bold"
               Foreground="#5A2E0E" Cursor="Hand"
               ToolTip="Remove a hero point (minimum 50)"/>

    <!-- Bottom hemisphere: clickable, shows current points -->
    <Border x:Name="PART_BottomArea"
            VerticalAlignment="Bottom" Height="40"
            Background="Transparent" Cursor="Hand"
            ToolTip="Left-click: spend a point  •  Right-click: restore">
      <TextBlock x:Name="PART_Current"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontFamily="Palatino Linotype" FontSize="15" FontWeight="Bold"
                 Foreground="#5A2E0E" IsHitTestVisible="False"/>
    </Border>
  </Grid>
</UserControl>
