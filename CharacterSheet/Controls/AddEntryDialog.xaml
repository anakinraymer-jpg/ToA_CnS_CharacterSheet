<Window x:Class="CharacterSheet.Controls.AddEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:CharacterSheet.Controls"
        Title="Add Entry"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="#1E1005"
        ShowInTaskbar="False">

  <Window.Resources>
    <ResourceDictionary Source="/Resources/Themes.xaml"/>
  </Window.Resources>

  <Border Padding="20,16,20,18">
    <StackPanel>

      <!-- Title -->
      <TextBlock x:Name="TbTitle" Text="Add Equipment"
                 FontFamily="Palatino Linotype" FontSize="13" FontWeight="Bold"
                 Foreground="#D4A96A" Margin="0,0,0,14"/>

      <!-- Name -->
      <TextBlock Text="NAME"
                 FontFamily="Palatino Linotype" FontSize="9"
                 Foreground="#8B5A2B" Margin="0,0,0,4"/>
      <TextBox x:Name="TbName" Style="{StaticResource DialogTextBox}" Margin="0,0,0,2"/>
      <ctrl:SkillPickerBox x:Name="SpName" Visibility="Collapsed" Margin="0,0,0,2"/>

      <!-- Description -->
      <TextBlock Text="DESCRIPTION"
                 FontFamily="Palatino Linotype" FontSize="9"
                 Foreground="#8B5A2B" Margin="0,12,0,4"/>
      <TextBox x:Name="TbDescription" Style="{StaticResource DialogTextBox}" Margin="0,0,0,2"/>

      <!-- Buttons -->
      <DockPanel Margin="0,18,0,0">
        <Button x:Name="BtnCancel" DockPanel.Dock="Right"
                Content="Cancel" Style="{StaticResource CtrlButton}"
                Padding="14,6" Margin="8,0,0,0"/>
        <Button x:Name="BtnAdd"
                Content="Add" Style="{StaticResource CtrlButton}"
                Padding="20,6" HorizontalAlignment="Right"/>
      </DockPanel>

    </StackPanel>
  </Border>
</Window>
