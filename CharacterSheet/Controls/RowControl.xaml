<UserControl x:Class="CharacterSheet.Controls.RowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CharacterSheet.Controls">

  <UserControl.Resources>
    <ResourceDictionary Source="/Resources/Themes.xaml"/>
  </UserControl.Resources>

  <!-- Row: equip | center | skill | die -->
  <Grid MinHeight="52">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="70"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="46"/>
    </Grid.ColumnDefinitions>

    <!-- ── Equipment side ─────────────────────────── -->
    <Border Grid.Column="0" Padding="2,5,6,4">
      <StackPanel VerticalAlignment="Center">
        <TextBox Style="{StaticResource RowNameTextBox}"
                 local:TextBoxHelper.Placeholder="item…"
                 Text="{Binding EquipName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Style="{StaticResource RowSubTextBox}"
                 local:TextBoxHelper.Placeholder="notes…"
                 Text="{Binding EquipSub, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- Dashed right divider of equip side -->
    <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1"
               Fill="{StaticResource ParchmentDkBrush}" Opacity="0.6"
               VerticalAlignment="Stretch" Margin="0,4,0,4"/>

    <!-- ── Center column ──────────────────────────── -->
    <Grid Grid.Column="1">
      <!-- Spine line -->
      <Rectangle Width="1" Fill="{StaticResource ParchmentDkBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
        <local:AdvCircle IsChecked="{Binding EquipUsed, Mode=TwoWay}"
                         ToolTip="Mark used" Margin="0,0,0,4"/>
        <local:AdvCircle IsChecked="{Binding SkillAdv, Mode=TwoWay}"
                         ToolTip="Mark advancement"/>
      </StackPanel>
    </Grid>

    <!-- ── Skill side ─────────────────────────────── -->
    <Border Grid.Column="2" Padding="6,5,6,4">
      <StackPanel VerticalAlignment="Center">
        <TextBox Style="{StaticResource RowNameTextBox}"
                 local:TextBoxHelper.Placeholder="skill…"
                 Text="{Binding SkillName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Style="{StaticResource RowSubTextBox}"
                 local:TextBoxHelper.Placeholder="notes…"
                 Text="{Binding SkillSub, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- Dashed left divider of die col -->
    <Rectangle Grid.Column="2" HorizontalAlignment="Right" Width="1"
               Fill="{StaticResource ParchmentDkBrush}" Opacity="0.6"
               VerticalAlignment="Stretch" Margin="0,4,0,4"/>

    <!-- ── Die bubble ─────────────────────────────── -->
    <Grid Grid.Column="3">
      <local:DieBubble Die="{Binding Die, Mode=TwoWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

  </Grid>
</UserControl>
